# Ключ ProxyAPI / OpenAI-совместимого API
OPENAI_KEY=your_openai_or_proxyapi_key
OPENAI_BASE_URL=https://api.proxyapi.ru/openai/v1

# Pinecone (Haystack читает PINECONE_API_KEY; PINICONE_TOKEN тоже поддерживается)
PINICONE_TOKEN=your_pinecone_api_key
PINECONE_INDEX_NAME=own-data-search
PINECONE_NAMESPACE=own_data_search

# Модели
CHAT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# Токен Telegram-бота от @BotFather
BOT_TOKEN=your_telegram_bot_token

# Таймаут ответа агента / обработки файла (секунды)
ASK_TIMEOUT_SEC=180

# Retrieval
RETRIEVAL_TOP_K=8
SIMILARITY_THRESHOLD=0.12
FACT_DEDUP_THRESHOLD=0.74
